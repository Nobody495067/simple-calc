    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 1] = uint(floatBitsToUint(u_xlat1.y));
    outVertices_buf[gl_GlobalInvocationID.x].value[(0 >> 2) + 2] = uint(floatBitsToUint(u_xlat1.z));
    return;
}
